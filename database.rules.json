{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'hospital_admin')"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).exists())"
      }
    },
    "patients": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "appointments": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "queue_entries": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "hospitals": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "doctors": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "doctor_schedules": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["doctor_id"]
    },
    "appointment_slots": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["doctor_id"]
    },
    "qualifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "specializations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "internal_users": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["email"]
    },
    "audit_logs": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["affected_id"]
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "tickets": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
